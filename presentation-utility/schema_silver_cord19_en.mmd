    }

    paper_institutions {
        string cord_uid FK "237,184 papers"
        string institution_norm "unique per paper - task 2.3.2"
    }

    papers ||--o{ paragraphs : "1 row per paragraph"
    papers ||--o{ authors : "1 row per author"
    papers ||--o{ paper_countries : "1 row per country"
    papers ||--o{ paper_institutions : "1 row per institution"
