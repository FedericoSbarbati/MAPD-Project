erDiagram
    papers {
        string cord_uid PK "unique after dedup"
        string title "482 null"
        string title_norm "matching key"
        int32 title_dup_count "max 82"
        bool is_title_unique "28.0% false"
        bool title_ok "present and >= 3 chars"
        string abstract "21.35% null"
        int16 year "from publish_time[:4]"
        bool has_pdf "373,750"
        bool has_pmc "315,726"
        string passthrough[13] "bibliographic columns, kept as-is"
    }

    paragraphs {
        string cord_uid FK "never null"
        string paper_id "sha or pmcid"
